{
  "backend": {
    "name": "github",
    "repo": "macv0223/psalm-23-trasnportation",
    "branch": "main",
    "base_url": "https://not-configured.invalid",
    "auth_endpoint": "auth",
    "squash_merges": true
  },
  "publish_mode": "editorial_workflow",
  "media_folder": "public/assets/uploads",
  "public_folder": "assets/uploads",
  "site_url": "https://macv0223.github.io/psalm-23-trasnportation/",
  "display_url": "https://macv0223.github.io/psalm-23-trasnportation/",
  "logo_url": "../assets/favicon.png",
  "show_preview_links": false,
  "collections": [
    {
      "name": "site",
      "label": "Website content",
      "description": "All words, services, imagery and contact information in one place.",
      "files": [
        {
          "name": "site",
          "label": "Psalm 23 website",
          "file": "content/site.json",
          "fields": [
            {
              "name": "settings",
              "label": "Business details & visual branding",
              "widget": "object",
              "collapsed": false,
              "fields": [
                {
                  "name": "businessName",
                  "label": "Business name",
                  "widget": "string"
                },
                {
                  "name": "brandTop",
                  "label": "Brand name (first line)",
                  "widget": "string"
                },
                {
                  "name": "brandBottom",
                  "label": "Brand name (second line)",
                  "widget": "string"
                },
                {
                  "name": "phone",
                  "label": "Call / text telephone number",
                  "widget": "string"
                },
                {
                  "name": "email",
                  "label": "Contact email",
                  "widget": "string",
                  "pattern": [
                    "^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$",
                    "Enter a valid email address"
                  ]
                },
                {
                  "name": "logo",
                  "label": "Primary gold wordmark / header logo",
                  "widget": "image",
                  "allow_multiple": false,
                  "required": false,
                  "hint": "Approved transparent PNG wordmark; displays on black without a coloured rectangle."
                },
                {
                  "name": "logoAlt",
                  "label": "Logo description",
                  "widget": "text"
                },
                {
                  "name": "featureGraphic",
                  "label": "Supplementary truck graphic (stored, not displayed)",
                  "widget": "image",
                  "allow_multiple": false,
                  "required": false,
                  "hint": "Client-supplied truck & mountains Graphic 1."
                },
                {
                  "name": "featureGraphicAlt",
                  "label": "How-it-works image description",
                  "widget": "text"
                },
                {
                  "name": "showcaseGraphic",
                  "label": "Supplementary hauling graphic (stored, not displayed)",
                  "widget": "image",
                  "allow_multiple": false,
                  "required": false,
                  "hint": "Client-supplied truck with mountains & cross Graphic 2."
                },
                {
                  "name": "showcaseGraphicAlt",
