                  "label": "Name placeholder",
                  "widget": "string"
                },
                {
                  "name": "pickupLabel",
                  "label": "Pickup label",
                  "widget": "string"
                },
                {
                  "name": "pickupPlaceholder",
                  "label": "Pickup placeholder",
                  "widget": "string"
                },
                {
