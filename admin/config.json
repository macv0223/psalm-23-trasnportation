                  "label": "Transportation services \u2014 add, edit, or reorder",
                  "widget": "list",
                  "min": 1,
                  "max": 12,
                  "summary": "{{fields.number}} \u00b7 {{fields.title}}",
                  "fields": [
                    {
                      "name": "number",
                      "label": "Number (01, 02, 03, etc.)",
                      "widget": "string"
                    },
                    {
                      "name": "title",
                      "label": "Service title",
                      "widget": "string"
                    },
                    {
                      "name": "description",
                      "label": "Service details",
                      "widget": "text"
                    }
                  ]
                }
              ]
            },
            {
              "name": "story",
              "label": "Our story",
              "widget": "object",
              "collapsed": false,
              "fields": [
                {
                  "name": "eyebrow",
                  "label": "Upper label",
                  "widget": "string"
                },
                {
                  "name": "headline1",
                  "label": "Headline first line",
                  "widget": "string"
                },
                {
                  "name": "headline2",
                  "label": "Headline second line",
                  "widget": "string"
                },
                {
                  "name": "paragraph1",
                  "label": "First paragraph",
                  "widget": "text"
                },
                {
                  "name": "paragraph2",
                  "label": "Second paragraph",
                  "widget": "text"
                },
                {
                  "name": "verse",
                  "label": "Bible verse / quotation",
                  "widget": "text"
                },
                {
                  "name": "verseCitation",
                  "label": "Verse citation",
                  "widget": "string"
                },
                {
                  "name": "storyImage",
                  "label": "Optional story photo",
                  "widget": "image",
                  "required": false,
                  "allow_multiple": false
                },
                {
                  "name": "storyImageAlt",
                  "label": "Story image description",
                  "widget": "text",
                  "required": false,
                  "hint": "Required only when a custom image is added."
                }
              ]
            },
            {
              "name": "quote",
              "label": "Quote request form",
              "widget": "object",
              "collapsed": false,
              "fields": [
                {
                  "name": "eyebrow",
                  "label": "Upper label",
                  "widget": "string"
                },
                {
                  "name": "headline1",
                  "label": "Headline first line",
                  "widget": "string"
                },
                {
                  "name": "headline2",
                  "label": "Headline second line",
                  "widget": "string"
                },
                {
                  "name": "intro",
                  "label": "Introductory paragraph",
                  "widget": "text"
                },
                {
