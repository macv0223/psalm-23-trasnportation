{
  "backend": {
    "name": "github",
    "repo": "macv0223/Psalm23-Truck-Logo",
    "branch": "main",
    "base_url": "https://not-configured.invalid",
    "auth_endpoint": "auth",
    "squash_merges": true
  },
  "publish_mode": "editorial_workflow",
  "media_folder": "public/assets/uploads",
  "public_folder": "assets/uploads",
  "site_url": "https://macv0223.github.io/Psalm23-Truck-Logo/",
  "display_url": "https://macv0223.github.io/Psalm23-Truck-Logo/",
  "logo_url": "../assets/favicon.png",
  "show_preview_links": false,
  "collections": [
    {
      "name": "site",
      "label": "Edit website",
      "description": "Edit every public section of Psalm 23 Transportation here.",
      "files": [
        {
          "name": "site",
          "label": "All website content",
          "file": "content/site.json",
          "fields": [
            {
              "name": "settings",
              "label": "Branding & contact details",
              "widget": "object",
              "collapsed": false,
              "fields": [
                {
                  "name": "businessName",
                  "label": "Business name",
                  "widget": "string"
                },
                {
                  "name": "brandTop",
                  "label": "Logo wordmark: top line",
                  "widget": "string"
                },
                {
                  "name": "brandBottom",
                  "label": "Logo wordmark: bottom line",
                  "widget": "string"
                },
                {
                  "name": "phone",
                  "label": "Phone / text number",
                  "widget": "string"
                },
                {
                  "name": "email",
                  "label": "Contact email",
                  "widget": "string",
                  "pattern": [
                    "^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$",
                    "Enter a valid email address"
                  ]
                },
                {
                  "name": "logo",
                  "label": "Primary puzzle-cross logo",
                  "widget": "image",
                  "required": false,
                  "allow_multiple": false,
                  "hint": "The new bronze-and-green jigsaw cross is already installed. Upload a replacement here only if the business approves a new logo."
                },
                {
                  "name": "logoAlt",
                  "label": "Logo image description for accessibility",
                  "widget": "text"
                },
                {
                  "name": "tagline",
                  "label": "Brand tagline",
                  "widget": "string"
                },
                {
                  "name": "verseReference",
                  "label": "Scripture reference",
                  "widget": "string"
                },
                {
                  "name": "copyrightYear",
                  "label": "Copyright year",
                  "widget": "string"
                },
                {
                  "name": "primaryColor",
                  "label": "Dark green brand color",
                  "widget": "string",
                  "pattern": [
                    "^#[0-9a-fA-F]{6}$",
                    "Use a six-digit hex value, such as #12312f"
                  ]
                },
                {
                  "name": "accentColor",
                  "label": "Gold brand color",
                  "widget": "string",
                  "pattern": [
                    "^#[0-9a-fA-F]{6}$",
                    "Use a six-digit hex value, such as #12312f"
                  ]
                }
              ]
            },
            {
              "name": "navigation",
              "label": "Navigation links",
              "widget": "object",
              "collapsed": false,
              "fields": [
                {
                  "name": "services",
                  "label": "Services link",
                  "widget": "string"
                },
                {
                  "name": "story",
                  "label": "Story link",
                  "widget": "string"
                },
                {
                  "name": "quote",
                  "label": "Quote link",
                  "widget": "string"
                }
              ]
            },
            {
              "name": "hero",
              "label": "Homepage hero",
              "widget": "object",
              "collapsed": false,
              "fields": [
                {
                  "name": "eyebrow",
                  "label": "Upper label",
                  "widget": "string"
                },
                {
                  "name": "headline1",
                  "label": "Headline first line",
                  "widget": "string"
                },
                {
                  "name": "headline2",
                  "label": "Headline second line",
                  "widget": "string"
                },
                {
                  "name": "intro",
                  "label": "Introductory paragraph",
                  "widget": "text"
                },
                {
                  "name": "primaryButton",
                  "label": "Quote button text",
                  "widget": "string"
                },
                {
                  "name": "secondaryButton",
                  "label": "Phone button text",
                  "widget": "string"
                },
                {
                  "name": "ribbon",
                  "label": "Ribbon text under hero",
                  "widget": "string"
                },
                {
                  "name": "heroImage",
                  "label": "Optional truck / hero image",
                  "widget": "image",
                  "required": false,
                  "allow_multiple": false
                },
                {
                  "name": "heroImageAlt",
                  "label": "Hero image description",
                  "widget": "text",
                  "required": false,
                  "hint": "Required only when a custom image is added."
                }
              ]
            },
            {
              "name": "services",
              "label": "Hauling services",
              "widget": "object",
              "collapsed": false,
              "fields": [
                {
                  "name": "eyebrow",
                  "label": "Upper label",
                  "widget": "string"
                },
                {
                  "name": "headline1",
                  "label": "Headline first line",
                  "widget": "string"
                },
